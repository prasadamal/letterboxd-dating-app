PORT=4000
NODE_ENV=development
# Reverse proxies in front of the API (defaults to 1 in production). Needed for per-client rate limits.
TRUST_PROXY=
JWT_SECRET=dev-only-change-me-32chars-min!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-32chars-min!!
CLIENT_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# From Supabase Dashboard → Project Settings → API (never commit real keys)
# Service role is required: RLS blocks the anon key from reading app tables.
SUPABASE_URL=https://kounpkxjjkuoabbofgay.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Email provider (password reset + verification). Without it, dev mode shows the link in the app instead.
RESEND_API_KEY=
EMAIL_FROM=ReelMates <noreply@yourdomain.com>

# Dating opens city by city (150 women + 150 men by default); change the target or open cities in /admin.
# Local testing: make THIS API report dating as open without changing the shared database. Never in production.
FORCE_DATING_OPEN=false
DAILY_MOVIE_COUNT=10

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40

# Admin moderation UI (/admin) + API
ADMIN_API_KEY=

# Cron-triggered jobs (daily game push reminders)
CRON_SECRET=
# ReelMates Plus: the Authorization header value you set on the RevenueCat webhook (16+ chars).
REVENUECAT_WEBHOOK_AUTH=

# Inactivity: pause matchmaking after N days without activity (default 180)
INACTIVE_USER_DAYS=180

# Optional observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Extra words/phrases rejected in chat and profile text (comma-separated), on top of the built-in list
CONTENT_BLOCKLIST=
