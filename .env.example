PORT=4000
NODE_ENV=development
JWT_SECRET=dev-only-change-me-32chars-min!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-32chars-min!!
CLIENT_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# From Supabase Dashboard → Project Settings → API (never commit real keys)
# Service role is required: RLS blocks the anon key from reading app tables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional email provider (password reset + verification)
RESEND_API_KEY=
EMAIL_FROM=ReelMates <noreply@yourdomain.com>

LAUNCH_MALE_TARGET=500
LAUNCH_FEMALE_TARGET=500
DAILY_MOVIE_COUNT=10

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40

# Admin moderation UI (/admin) + API
ADMIN_API_KEY=

# Cron-triggered jobs (daily game push reminders)
CRON_SECRET=

# Inactivity: pause matchmaking after N days without activity (default 180)
INACTIVE_USER_DAYS=180

# Optional observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
