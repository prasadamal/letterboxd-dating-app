* {
  box-sizing: border-box;
}

:root {
  --bg: #0f1116;
  --bg-alt: #171b23;
  --panel: rgba(23, 27, 35, 0.9);
  --panel-strong: #1b212b;
  --card: #121821;
  --line: rgba(255, 255, 255, 0.08);
  --text: #edf3ff;
  --muted: #a8b1c0;
  --soft: #d7e4ff;
  --peach: #f6b29a;
  --pink: #ff6f91;
  --purple: #b08cff;
  --green: #70e0a2;
  --shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(176, 140, 255, 0.22), transparent 30%),
    radial-gradient(circle at bottom right, rgba(246, 178, 154, 0.14), transparent 26%),
    var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
}

button {
  border: none;
  cursor: pointer;
  font: inherit;
}

img {
  display: block;
  max-width: 100%;
}

h1,
h2,
h3,
h4 {
  margin: 0;
}

p {
  margin: 0;
}

#root {
  min-height: 100vh;
}

.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 28px 20px 36px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 14px 18px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: rgba(17, 20, 27, 0.75);
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--pink), var(--purple));
  color: white;
  font-weight: 800;
}

.eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.eyebrow.accent {
  color: var(--peach);
}

.brand-wrap h1 {
  font-size: clamp(1.2rem, 2vw, 1.7rem);
  letter-spacing: -0.06em;
}

.nav {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
}

.nav-pill,
.primary-button,
.ghost-button {
  border-radius: 999px;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.nav-pill {
  padding: 10px 16px;
  background: transparent;
  color: var(--muted);
}

.nav-pill.active {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text);
}

.primary-button,
.ghost-button {
  padding: 12px 18px;
  font-weight: 600;
}

.primary-button {
  background: linear-gradient(135deg, var(--pink), var(--purple));
  color: white;
  box-shadow: 0 18px 40px rgba(176, 140, 255, 0.3);
}

.primary-button.small {
  padding: 10px 14px;
  font-size: 0.83rem;
}

.ghost-button {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  border: 1px solid var(--line);
}

.page-grid {
  display: grid;
  grid-template-columns: 1.5fr 0.8fr;
  gap: 22px;
  margin-top: 26px;
}

.card-panel {
  background: rgba(17, 20, 27, 0.76);
  border: 1px solid var(--line);
  border-radius: 26px;
  box-shadow: var(--shadow);
}

.hero {
  display: grid;
  grid-template-columns: 1.45fr 0.8fr;
  gap: 18px;
  padding: 26px;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.hero-copy h2 {
  font-size: clamp(2.35rem, 4vw, 4.3rem);
  line-height: 0.95;
  letter-spacing: -0.07em;
  max-width: 520px;
}

.hero-text {
  max-width: 540px;
  font-size: 1.04rem;
  line-height: 1.7;
  color: var(--muted);
}

.cta-row {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.stat-row {
  display: flex;
  gap: 26px;
  flex-wrap: wrap;
  padding-top: 8px;
}

.stat-row div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-row strong {
  font-size: 1.1rem;
}

.stat-row span {
  color: var(--muted);
  font-size: 0.82rem;
}

.inner-panel {
  padding: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
}

.avatar-ring {
  width: 128px;
  height: 128px;
  padding: 4px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pink), var(--purple));
  margin: 0 auto 18px;
}

.avatar-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background:
    linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)),
    url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80') center/cover;
}

.mini-meta {
  text-align: center;
  margin-bottom: 18px;
}

.mini-meta h3 {
  margin-top: 8px;
  font-size: 2rem;
  letter-spacing: -0.06em;
}

.mini-meta p {
  color: var(--muted);
}

.taste-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.taste-tags span,
.genre-row span,
.label-chip {
  display: inline-flex;
  align-items: center;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  color: var(--soft);
  font-size: 0.75rem;
}

.sidebar {
  padding: 20px 18px;
}

.sidebar-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
}

.sidebar-head h3 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.06em;
}

.meter {
  position: relative;
  height: 12px;
  margin: 18px 0 20px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--line);
}

.meter span {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--green), var(--peach), var(--purple));
}

.match-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255,255,255,0.02);
}

.match-card img {
  width: 80px;
  height: 80px;
  border-radius: 18px;
  object-fit: cover;
}

.match-card h4 {
  font-size: 1.2rem;
  margin-bottom: 4px;
}

.match-card p {
  color: var(--muted);
}

.watchlist-list {
  list-style: none;
  padding: 0;
  margin: 22px 0 0;
  display: grid;
  gap: 12px;
}

.watchlist-list li {
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(255,255,255,0.02);
  color: var(--soft);
}

.discover-section {
  grid-column: 1 / -1;
  margin-top: 12px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-head h3 {
  margin-top: 10px;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
  letter-spacing: -0.06em;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.person-card {
  overflow: hidden;
}

.person-image-wrap {
  position: relative;
  height: 270px;
}

.person-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.score-badge {
  position: absolute;
  top: 18px;
  left: 18px;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(15, 17, 22, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.08);
  font-size: 0.72rem;
  font-weight: 700;
}

.person-body {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 22px 20px 18px;
}

.identity-row {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
}

.identity-row h4 {
  font-size: 1.8rem;
  letter-spacing: -0.06em;
}

.identity-row p {
  color: var(--muted);
  margin-top: 6px;
}

.bio {
  color: var(--muted);
  line-height: 1.7;
}

.genre-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.favorite-lists {
  display: grid;
  gap: 12px;
}

.favorite-lists div {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.favorite-lists span {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.7rem;
}

.favorite-lists p {
  color: var(--soft);
  line-height: 1.6;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

@media (max-width: 980px) {
  .page-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .card-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {
  .app-shell {
    padding-inline: 12px;
  }

  .topbar {
    flex-wrap: wrap;
  }

  .nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .hero,
  .sidebar,
  .person-body {
    padding-inline: 16px;
  }

  .hero-copy h2 {
    font-size: 2.5rem;
  }

  .identity-row {
    flex-direction: column;
  }
}
