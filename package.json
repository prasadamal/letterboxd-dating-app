{
  "name": "reelmates",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 0.0.0.0 --port 3000",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "NODE_ENV=production node server/index.js",
    "db:seed": "node server/scripts/seedMovies.js",
    "db:seed:demo": "node server/scripts/seedDemoUsers.js",
    "mobile": "cd mobile && npm start",
    "mobile:typecheck": "cd mobile && npm run typecheck",
    "test": "node --test server/tests/*.test.js server/tests/integration/*.test.js",
    "test:integration": "INTEGRATION_TEST=1 node --test server/tests/integration/*.test.js",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.10"
  }
}
